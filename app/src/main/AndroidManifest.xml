<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Bajar el reconocedor de voz la primera vez (unos 160 MB); lo demás va sin conexión. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Seguir sonando con la app de fondo, con los mandos del sistema (notificación y pantalla de bloqueo). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_letrasync"
        android:roundIcon="@drawable/ic_letrasync"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:largeHeap="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- La sincronización automática, en su propio proceso: si el reconocedor se cae, la app sigue. -->
        <service android:name=".ServicioDeMusica" android:exported="false" android:foregroundServiceType="mediaPlayback" />
        <service android:name=".ServicioAutomatico" android:process=":reconocedor" android:exported="false" />

        <activity
            android:name=".ui.LetraSyncActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Desde PinDesk: la canción y su letra; vuelve con la letra sincronizada. -->
            <intent-filter>
                <action android:name="com.letrasyncpro.action.SINCRONIZAR" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <!-- Abrir una canción desde otra aplicación (compartir o «abrir con»). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
